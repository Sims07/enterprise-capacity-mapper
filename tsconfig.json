{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "allowJs": false,
    "noEmit": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "types": [
      "vite/client",
      "node",
      "cypress"
    ],
    "strict": true,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "strictPropertyInitialization": false,
    "useUnknownInCatchVariables": true
  },
  "include": [
    "src",
    "cypress",
    "cypress.config.ts",
    "vite.config.ts",
    "scripts/**/*.ts"
  ],
  "exclude": [
    "src/**/*.test.ts"
  ]
}
